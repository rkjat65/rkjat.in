<nav class="breadcrumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/platforms/">Platforms</a><span aria-hidden="true">/</span><span aria-current="page">{{platform.name}}</span></nav>
<section class="detail-hero wrap">
  <div><p class="eyebrow">{{platform.label}}</p><h1>{{platform.name}}</h1><p class="lead">{{platform.intro}}</p><div class="button-row"><a class="button primary" href="{{platform.url}}" {{#if platform.external}}target="_blank" rel="noopener noreferrer"{{/if}}>{{platform.action}} <span aria-hidden="true">↗</span></a><a class="button secondary" href="/platforms/">All platforms</a></div><ul class="tags">{{#each platform.tags}}<li>{{this}}</li>{{/each}}</ul></div>
  <figure class="detail-preview {{platform.imageClass}}"><img src="{{platform.image}}" alt="{{platform.alt}}" width="1200" height="675" fetchpriority="high" decoding="async">{{#if platform.cricketArt}}<span class="preview-wordmark">CRICKET<br>WICKET<span>.</span></span>{{/if}}<figcaption>{{platform.label}} · {{platform.name}}</figcaption></figure>
</section>
<section class="section wrap" aria-labelledby="explore-title"><div class="section-heading"><p class="eyebrow">Inside the platform</p><h2 id="explore-title">What you can explore.</h2></div><div class="feature-grid">{{#each platform.features}}<article class="feature"><span class="feature-index" aria-hidden="true">0{{number}}</span><h3>{{title}}</h3><p>{{text}}</p></article>{{/each}}</div></section>
<section class="section section-tint"><div class="wrap reading-grid"><div><p class="eyebrow">The thinking behind it</p><h2>Context matters.</h2></div><div class="prose">{{#each platform.sections}}<h3>{{title}}</h3><p>{{text}}</p>{{/each}}{{#if platform.links}}<ul class="resource-links">{{#each platform.links}}<li><a href="{{url}}" target="_blank" rel="noopener noreferrer">{{label}} ↗</a></li>{{/each}}</ul>{{/if}}<p class="coverage-note">{{platform.note}}</p></div></div></section>
<section class="section wrap"><div class="section-heading heading-row"><div><p class="eyebrow">Keep exploring</p><h2>More from my platforms.</h2></div><a class="text-link" href="/platforms/">See all platforms →</a></div><div class="platform-grid">{{#each relatedPlatforms}}{{> platform-card}}{{/each}}</div></section>
